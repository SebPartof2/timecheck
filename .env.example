# VATSIM Connect OAuth (https://auth.vatsim.net for production, https://auth-dev.vatsim.net for sandbox)
VATSIM_OAUTH_BASE=
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=
# Optional. If unset, the redirect URI is derived from the inbound request as <scheme>://<host>/auth/callback
VATSIM_REDIRECT_URI=

# VATUSA API (used to look up name, rating, and HCF roles by CID)
VATUSA_API_BASE=https://api.vatusa.net/
# Required for /api/roster/{home|visit}. Sent as ?apikey=... query param.
VATUSA_API_KEY=
# Facility id used for the roster endpoints (e.g. HCF).
VATUSA_FACILITY=HCF

# Express session signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=.env.example

# Set to "production" on Railway so session cookies are marked Secure
NODE_ENV=production

# Railway sets PORT automatically; only override locally if needed
PORT=3001

# Debug only: when set, any successful VATSIM Connect login is treated as this CID
# for the VATUSA lookup and the session. Leave unset in production.
DEBUG_CID=

# Max requests per second to api.vatsim.net (shared across all in-flight roster
# fetches). Lower if you hit 429s; default 2.
VATSIM_RPS=2
